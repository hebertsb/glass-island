{
  "name": "glass-island",
  "version": "1.0.0",
  "description": "Dynamic Island interactiva para Windows 10/11 con Liquid Glass, Frutiger Aero y Asistente de Voz IA Hibrido (N.O.V.A.)",
  "author": "Hebert Suarez Burgos",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:ui": "npm --prefix ui run build",
    "dist:win": "npm run build:ui && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.hebertsb.glassisland",
    "productName": "GlassIsland",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/glassdrop.cjs",
      "ui/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/win_bridge.ps1",
        "to": "electron/win_bridge.ps1"
      },
      {
        "from": "electron/voice_daemon.py",
        "to": "electron/voice_daemon.py"
      },
      {
        "from": "assets/glassisland.ico",
        "to": "assets/glassisland.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/glassisland.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GlassIsland"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
